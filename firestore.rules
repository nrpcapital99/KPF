rules_version = '2';

// Kanak Parakh Foundation
//
//   Anyone      → may submit ONE well-formed volunteer response. Cannot read anything.
//   Team        → may read, update the status/note of, and delete responses.
//   Everything else is denied.
//
// A team member is a signed-in Firebase Auth user who is either the original
// admin (config/foundation.bootstrapUid) or has a document at admins/{uid}.
// Add team members in the Firebase console: Firestore → admins → Add document,
// with the person's Auth UID as the document ID.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeam() {
      let foundation = /databases/$(database)/documents/config/foundation;
      return signedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (exists(foundation) && get(foundation).data.bootstrapUid == request.auth.uid)
      );
    }

    function optionalString(data, key, maxLength) {
      return !(key in data)
        || data[key] == null
        || (data[key] is string && data[key].size() <= maxLength);
    }

    // ⚠ These lists mirror src/config.ts (and google-sheets/Code.gs).
    //   Change them together, then redeploy.
    function helpOptionIds() {
      return ['edu_teaching', 'edu_tutoring', 'edu_career_guidance',
              'edu_subject_expertise', 'edu_other', 'trn_soft_skills',
              'trn_communication', 'trn_financial_literacy', 'trn_career_readiness',
              'trn_professional', 'trn_other', 'dm_linkedin', 'dm_instagram',
              'dm_facebook', 'dm_strategy', 'dm_paid_ads', 'dm_content_strategy',
              'dm_seo', 'dm_other', 'web_development', 'web_maintenance', 'web_uiux',
              'web_seo', 'web_content', 'web_support', 'web_other', 'vid_shooting',
              'vid_editing', 'vid_reels', 'vid_animation', 'vid_photography',
              'vid_other', 'des_graphic', 'des_posters', 'des_presentations',
              'des_branding', 'des_illustration', 'des_tools', 'des_other',
              'fr_fundraising', 'fr_donor_outreach', 'fr_corporate', 'fr_csr',
              'fr_sponsorships', 'fr_events', 'fr_networking'];
    }

    function commitmentIds() {
      return ['w1_2', 'w3_4'];
    }

    function timeIds() {
      return ['weekday_mornings', 'weekday_evenings', 'weekends', 'flexible'];
    }

    function statusIds() {
      return ['NEW', 'CONTACTED', 'JOINED', 'ARCHIVED'];
    }

    function isValidSubmission(d) {
      return d.keys().hasOnly([
          'fullName', 'phone', 'email', 'city', 'helpWith', 'digitalSpecifics',
          'techSpecifics', 'otherContribution', 'commitment', 'preferredTimes',
          'message', 'consent', 'status', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'fullName', 'phone', 'email', 'helpWith', 'consent', 'status',
          'createdAt', 'updatedAt'
        ])

        && d.fullName is string
        && d.fullName.size() >= 1 && d.fullName.size() <= 100

        && d.phone is string
        && d.phone.size() >= 8 && d.phone.size() <= 20
        && d.phone.matches('^[0-9+() -]+$')

        && d.email is string
        && d.email.size() <= 254
        && d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')

        && optionalString(d, 'city', 80)
        && optionalString(d, 'digitalSpecifics', 500)
        && optionalString(d, 'techSpecifics', 500)
        && optionalString(d, 'otherContribution', 1000)
        && optionalString(d, 'message', 1000)

        && d.helpWith is list
        && d.helpWith.size() <= 46
        && d.helpWith.hasOnly(helpOptionIds())
        // Must say how they'd like to help: at least one option, or a note
        // under "Other Ways to Contribute".
        && (d.helpWith.size() > 0
            || (('otherContribution' in d) && d.otherContribution is string
                && d.otherContribution.size() > 0))

        && (!('preferredTimes' in d)
            || (d.preferredTimes is list && d.preferredTimes.size() <= 4
                && d.preferredTimes.hasOnly(timeIds())))
        && (!('commitment' in d) || d.commitment == null
            || d.commitment in commitmentIds())

        && d.consent == true
        && d.status == 'NEW'
        // Must be the server's clock, so a submission can't be backdated.
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /volunteers/{responseId} {
      allow create: if isValidSubmission(request.resource.data);

      allow read, delete: if isTeam();

      allow update: if isTeam()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'note', 'updatedAt'])
        && request.resource.data.status in statusIds()
        && optionalString(request.resource.data, 'note', 500)
        && request.resource.data.updatedAt == request.time;
    }

    // Managed from the Firebase console only. A person may check their own entry.
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Holds bootstrapUid for the original admin. Read only by these rules.
    match /config/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
