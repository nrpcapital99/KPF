# Firebase web app config — Project settings > General > Your apps > SDK setup
# Copy this file to .env.local and fill in the values.
# These are safe to ship in the client bundle; access control lives in the
# Firebase Authentication and firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: use the Auth and Firestore emulators from firebase.json.
VITE_USE_FIREBASE_EMULATORS=false
